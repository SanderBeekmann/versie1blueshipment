# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===================================
# SMTP Email Configuration
# ===================================
# These environment variables are used by the Edge Function to send emails.
# The Edge Function uses Nodemailer with SMTP to send two emails:
# 1. Confirmation email to the lead
# 2. Notification email to the internal sales team

# SMTP Server Configuration
# --------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password-or-app-token

# Email Addresses
# ---------------
MAIL_FROM=noreply@yourdomain.com
INTERNAL_NOTIFY_EMAIL=sales@yourdomain.com

# ===================================
# SMTP Provider Examples
# ===================================

# Google Workspace / Gmail
# ------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# Note: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords

# Microsoft 365 / Outlook
# -----------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# Mailgun SMTP
# ------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your-mailgun-smtp-password

# SendGrid SMTP
# -------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Amazon SES SMTP
# ---------------
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-username
# SMTP_PASS=your-ses-smtp-password

# ===================================
# Configuration Notes
# ===================================
#
# SMTP_HOST: The SMTP server hostname
# SMTP_PORT: Common ports are 587 (TLS), 465 (SSL), or 25 (unencrypted)
# SMTP_SECURE: Set to "true" for port 465 (SSL), "false" for port 587 (TLS/STARTTLS)
# SMTP_USER: Your SMTP username (usually your email address)
# SMTP_PASS: Your SMTP password or app-specific password
#
# MAIL_FROM: The "From" address that appears in sent emails
# INTERNAL_NOTIFY_EMAIL: Internal email address to receive lead notifications
#
# Security: These variables are only available server-side in Edge Functions.
# They are NEVER exposed to the client browser.
